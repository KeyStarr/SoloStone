<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><EngineSource>true</EngineSource></PropertyGroup>
  <Import Project="../../data/packs/FairPackResources.props" />
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../data/progression/card-mastery.json" LogicalName="SoloStone.Progression.card-mastery.json" />
    <EmbeddedResource Include="golden-v2.json" LogicalName="FairPackGoldenV2.json" />
    <EmbeddedResource Include="golden-v1.json" LogicalName="FairPackGoldenV1.json" />
    <Compile Include="../../plugin/FairPackRules.cs" Link="FairPackRules.cs" />
    <Compile Include="../shared/MiniJSON.cs" Link="MiniJSON.cs" />
  </ItemGroup>
  <PropertyGroup><DefineConstants>$(DefineConstants);ENGINE_SOURCE</DefineConstants></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../engine/SabberStoneCore/SabberStoneCore.csproj" /></ItemGroup>
</Project>
