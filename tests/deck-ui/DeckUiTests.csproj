<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugin/DeckGeometry.cs" Link="DeckGeometry.cs" />
    <Compile Include="../../plugin/ButtonChromeRules.cs" Link="ButtonChromeRules.cs" />
    <Compile Include="../../plugin/DeckRecordLayout.cs" Link="DeckRecordLayout.cs" />
    <Compile Include="../../plugin/HandheldPolicy.cs" Link="HandheldPolicy.cs" />
    <Compile Include="../../plugin/ProfileMenuGeometry.cs" Link="ProfileMenuGeometry.cs" />
    <Compile Include="../../plugin/NativeSaveDeleteText.cs" Link="NativeSaveDeleteText.cs" />
    <Compile Include="$(IntermediateOutputPath)DeckRuntime.Generated.cs" />
  </ItemGroup>
  <Target Name="ExtractDeckRuntime" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract_runtime.py&quot; &quot;$(IntermediateOutputPath)DeckRuntime.Generated.cs&quot;" />
  </Target>
</Project>
