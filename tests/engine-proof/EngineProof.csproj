<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../data/packs/FairPackResources.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);SOURCE_ENGINE;ENGINE_SOURCE</DefineConstants>
  </PropertyGroup>
  <!-- Two builds of one source (docs/TESTING.md). Default: the CI suite engine-proof, no client file needed.
       -p:ClientTransport=true: the client suite engine-proof-client, which adds the native match and the client's own libraries. -->
  <PropertyGroup Condition="'$(ClientTransport)' == 'true'"><DefineConstants>$(DefineConstants);CLIENT_TRANSPORT;PINNED_CLIENT_ALIAS</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../plugin/NativeStallClock.cs" Link="NativeStallClock.cs" />
    <Compile Include="../../plugin/NativeHeraldText.cs" Link="NativeHeraldText.cs" />
    <Compile Include="../GroupProofs.cs" Link="GroupProofs.cs" />
    <EmbeddedResource Include="definition-fixtures/*.b64" LogicalName="DefinitionFixtures/%(Filename).b64" />
    <None Include="legacy-generation-v1.sha256" CopyToOutputDirectory="PreserveNewest" />
    <None Include="event-traces/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Condition="'$(EngineDll)' == ''" Include="../../engine/SabberStoneCore/SabberStoneCore.csproj" />
    <Reference Condition="'$(EngineDll)' != ''" Include="SabberStoneCore"><HintPath>$(EngineDll)</HintPath><Private>true</Private></Reference>
    <Compile Include="../../sim/HsSim/Canonical.cs" Link="Canonical.cs" />
    <Compile Include="../../sim/Shared/PoolSnapshots.cs" Link="PoolSnapshots.cs" />
    <Compile Include="../../sim/HsSim/Simulation.cs" Link="Simulation.cs" />
    <Compile Include="../OfflinePoolTestRecipes.cs" Link="OfflinePoolTestRecipes.cs" />
    <Compile Include="../../plugin/FairBotState.cs" Link="FairBotState.cs" />
    <Compile Include="../../plugin/Npc/*.cs" LinkBase="Npc" />
    <Compile Include="../../plugin/Npc/World/*.cs" LinkBase="Npc/World" />
    <Compile Include="../../plugin/LocalNativeText.cs" Link="LocalNativeText.cs" />
    <Compile Include="../../plugin/BotSearch.cs" Link="BotSearch.cs" />
    <Compile Include="../../plugin/BotDriver.cs" Link="BotDriver.cs" />
    <Compile Include="../../plugin/LocalProfile.cs" Link="LocalProfile.cs" />
    <Compile Include="../../plugin/LocalAchievements.cs" Link="LocalAchievements.cs" />
    <Compile Include="../../plugin/LocalProfileAchievements.cs" Link="LocalProfileAchievements.cs" />
    <Compile Include="../../plugin/LocalAchievementCollector.cs" Link="LocalAchievementCollector.cs" />
    <Compile Include="../../plugin/LocalProfileCheats.cs" />
    <Compile Include="../../plugin/ProfileCatalog.cs" />
    <Compile Include="../../plugin/OfflineGuard.cs" />
    <Compile Include="../../plugin/LocalClassRewards.cs" />
    <Compile Include="../../plugin/LocalEconomy.cs" Link="LocalEconomy.cs" />
    <Compile Include="../../plugin/StableSeed.cs" Link="StableSeed.cs" />
    <Compile Include="../../plugin/LocalBot.cs" Link="LocalBot.cs" />
    <Compile Include="../../plugin/LocalDecks.cs" Link="LocalDecks.cs" />
    <Compile Include="../../plugin/LocalDeckCards.cs" Link="LocalDeckCards.cs" />
    <Compile Include="../../plugin/LocalCardCatalog.cs" Link="LocalCardCatalog.cs" />
    <Compile Include="../../research/modern-mechanics/ProofDecks.cs" Link="ProofDecks.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../shared/NativeMatchTransportId.cs" Link="NativeMatchTransportId.cs" /></ItemGroup>
  <ItemGroup Condition="'$(ClientTransport)' != 'true'">
    <Compile Include="../shared/MiniJSON.cs" Link="MiniJSON.cs" />
    <Compile Remove="PetTransportProof.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ClientTransport)' == 'true'">
    <Compile Include="../../plugin/NativeMatch.cs" Link="NativeMatch.cs" />
    <Compile Include="../../plugin/NativePetReactions.cs" Link="NativePetReactions.cs" />
    <Compile Include="../../plugin/NativePetLikes.cs" Link="NativePetLikes.cs" />
    <Compile Include="../../plugin/CopyTransportBridge.cs" Link="CopyTransportBridge.cs" />
    <Compile Include="../../plugin/AuraTransportBridge.cs" Link="AuraTransportBridge.cs" />
    <Reference Include="Blizzard.T5.MiniJSON"><HintPath>../../references/game/Blizzard.T5.MiniJSON.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><Aliases>pinnedClient</Aliases><HintPath>../../references/game/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="blizzard.bgsclient"><HintPath>../../references/game/blizzard.bgsclient.dll</HintPath></Reference>
    <Reference Include="blizzard.bgssdk"><HintPath>../../references/game/blizzard.bgssdk.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>../../references/game/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>../../references/game/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../plugin/RecipeLibrary.cs" Link="RecipeLibrary.cs" />
    <Compile Include="../../plugin/LocalShop.cs" Link="LocalShop.cs" />
    <Compile Include="../../plugin/LadderRules.cs" Link="LadderRules.cs" />
    <Compile Include="../../plugin/LocalProfileLadder.cs" Link="LocalProfileLadder.cs" />
    <Compile Include="../../plugin/LocalLadderMilestones.cs" Link="LocalLadderMilestones.cs" />
    <Compile Include="../../plugin/LocalProfileMilestones.cs" Link="LocalProfileMilestones.cs" />
    <Compile Include="../../plugin/FairPackRules.cs" Link="FairPackRules.cs" />
    <EmbeddedResource Include="../../data/shop/catalog-v1.json" LogicalName="SoloStone.Shop.catalog-v1.json" />
    <EmbeddedResource Include="../../data/pools/offline-standard-v1.json" LogicalName="SoloStone.Shop.active-pool.json" />
    <EmbeddedResource Include="../../data/shop/recipes-v1.json" LogicalName="SoloStone.Shop.recipes-v1.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../data/progression/card-mastery.json" LogicalName="SoloStone.Progression.card-mastery.json" />
    <Compile Include="../../plugin/LocalCardMastery.cs" Link="LocalCardMastery.cs" />
    <Compile Include="../../plugin/LocalCrafting.cs" Link="LocalCrafting.cs" />
  </ItemGroup>
<ItemGroup><Compile Include="../../plugin/GrindTiers.cs" Link="GrindTiers.cs" /></ItemGroup>
</Project>
