<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../data/packs/FairPackResources.props" />
  <!-- The checks of the native match that need no client: opponent runner, presentation, memory and rematch logic, and
       fair-view privacy on the engine. The rest of the native match is the client suite native-match. -->
