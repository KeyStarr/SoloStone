    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EngineSource>true</EngineSource>
    <DefineConstants>$(DefineConstants);ENGINE_SOURCE</DefineConstants>
