# Build output and local inputs. Nothing from a Hearthstone client belongs in this repository:
# the reference libraries you collect to build the plugin stay in references/ and are never committed.
bin/
obj/
out/
packages/
references/
__pycache__/
*.pyc
.DS_Store
*.dll
*.exe
*.pdb
*.nupkg
*.zip
# Key material of any kind. A release is signed offline; no private key belongs in this tree.
*.key
*.pem
*.pfx
*.p12

# Built or kept locally, never committed: private notes, the player's own game libraries, evidence, and the data
# generated from a client.
private/
references/
evidence/
data/carddb/
data/shop/client/
data/fx/*37.0.0*
dist/manifest.json
engine/SabberStoneCore/resources/Data/CardDefs.xml
engine/SabberStoneCore/resources/Data/ClientOverlay.xml
CLAUDE.local.md
