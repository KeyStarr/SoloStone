# Build output and local inputs. Nothing from a Hearthstone client belongs in this repository:
# the reference libraries you collect to build the plugin stay in references/ and are never committed.
bin/
obj/
out/
packages/
__pycache__/
*.pyc
.DS_Store
*.dll
*.exe
*.pdb
*.nupkg
*.zip
# Key material of any kind. A release is signed offline; no private key belongs in this tree.
*.key
*.pem
*.pfx
*.p12

# Built from your own Hearthstone client (docs/BUILDING.md), or kept locally: linked or copied in, never committed.
# In a worktree some of these are symlinks, which a pattern with a trailing slash does not match, so the names that can
# be links have none.
/references
/evidence
/private
/data/carddb
/data/shop/client
/data/fx/*37.0.0*
CardDefs.xml
ClientOverlay.xml

# Local agent files and worktrees: never committed.
/CLAUDE.local.md
/.claude
/.worktrees
